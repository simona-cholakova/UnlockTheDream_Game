  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "YOUR GOAL\nThree keys. One escape. The dream won't let you go easily.\nYou
    are trapped in a dream. Find 3 keys hidden across this strange world to unlock
    your way out. The path is yours to discover \u2014 but you are not alone here.\n\nKNOW
    YOUR ENEMIES\nThe Stormcallers fall from above, crackling with electric energy.
    Get too close and they'll shock you into submission.\nThe Frostwalkers stalk
    the ground, closing in slowly \u2014 but their icy energy blast will freeze you
    solid if your guard is down.\nYour shield absorbs the Frostwalker's blast. Your
    red energy \u2014 awakened by the potion \u2014 disrupts the Stormcallers fatally.
    Use both wisely.\nThe storage house is your sanctuary. Enemies won't touch you
    inside.\n\nCONTROLS\nMove with intention. Survive with precision.\nW / A / S
    / D \u2014 Move\nSpace \u2014 Jump\nC \u2014 Collect items into your inventory\nG
    \u2014 Release red energy (attack Stormcallers)\nF \u2014 Activate shield (protects
    against Frostwalkers for 7 seconds)\nPress F again to reactivate when ready\n\nFINDING
    THE KEYS\nThe dream does not give up its secrets easily.\nThis land bleeds pink
    \u2014 it is all you will see for miles. But once, just once, the crystals turn
    white. That is not an accident. That is a whisper. Follow it.\nThe second key
    does not want to be found. It is close to somewhere you already know \u2014 somewhere
    that feels safe. Look again. Look closer.\nThe third key is earned, not found.
    The dream will only release it when you have proven you belong here. Five Stormcallers
    must fall to your red energy. Four Frostwalkers must fail to freeze you. Only
    then will the way reveal itself.\nThe keys were never hidden from you. You just
    weren't ready to see them.\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
